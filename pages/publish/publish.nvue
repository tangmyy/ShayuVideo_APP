<style>
.page {
	position: absolute;
	left: 0;
	right: 0;
	top: 0;
	bottom: 0;
	background-color: #000000;
}
	
.header {
	position: absolute;
	left: 0;
	right: 0;
	flex-direction: row;
	height: 100rpx;
	line-height: 100rpx;
	align-items: center;
	padding-left: 40rpx;
	padding-right: 40rpx;
}

.header-center {
	flex: 1;
	flex-direction: row;
	align-items: center;
	justify-content: center;
}

.header-left,
.header-right {
	color: #999;
	height: 100rpx;
	line-height: 100rpx;
	align-items: flex-start;
	justify-content: flex-end;
	font-family: iconfont;
}

.header-right-search {
	height: 100rpx;
	/* align-items: flex-start;
	justify-content: flex-end; */
}

.header-item {
	align-items: center;
	margin-left: 6rpx;
	margin-right: 6rpx;
}

.header-item-title {
	width: 200rpx;
	text-align: center;
	height: 60rpx;
	line-height: 60rpx;
	color: #FFFFFF;
	font-size: 18px;
	font-weight: 400;
}

.header-refresh-title {
	width: 300rpx;
	text-align: center;
	height: 60rpx;
	line-height: 60rpx;
	color: #FFFFFF;
	font-size: 16px;
	font-weight: 600;
}

.header-item-line {
	height: 5rpx;
	line-height: 8rpx;
	width: 60rpx;
	border-radius: 8rpx;
}

.preplay-wrapper {
	display: flex;
	flex-direction: row;
	justify-content: center;
	margin-top: -90rpx;
	margin-left: 30rpx;
	border-width: 1px;
	/* border-color: #343438; */
	/* background-color: #0c0c0c; */
	padding: 6rpx 16rpx;
	width: 200rpx;
	border-radius: 20rpx;
}

.vlog-content {
	margin-top: 30rpx;
	height: 100px;
	color: #FFFFFF;
	font-size: 16px;
	background-color: #0c0c0c;
	padding-left: 10px;
	padding-top: 10px;
	padding-right: 10px;
	padding-bottom: 10px;
	border-radius: 10px;
}

.btn-preplay {
	background-color: #0c0c0c;
	border-color: #343438;
}

.btn-preplay-touched {
	background-color: #545456;
	border-color: #000000;
}

.btn-publish {
	background-color: #ef274d;
}

.btn-publish-touched {
	background-color: #de6981;
}

.choose-cover {
	display: flex;
	flex-direction: column;
	justify-content: center;
	width: 360rpx;
	background-color: #000000;
	opacity: 0.3;
	height: 50px;
	margin-left: 30rpx;
	border-bottom-right-radius: 10px;
	border-bottom-left-radius: 10px;
	position: relative;
	top: -50px;
}

	.tags-preview {
		margin-top: 20rpx;
		margin-left: 30rpx;
		margin-right: 30rpx;
		flex-direction: row;
		align-items: center;
		flex-wrap: wrap;
	}

	.tags-label {
		color: #9798a0;
		font-size: 14px;
		margin-right: 10rpx;
	}

	.tags-container {
		flex-direction: row;
		flex-wrap: wrap;
		flex: 1;
	}

	.tag-item {
		flex-direction: row;
		align-items: center;
		background-color: #ef274d;
		border-radius: 20rpx;
		padding: 8rpx 16rpx;
		margin-right: 10rpx;
		margin-bottom: 10rpx;
	}

	.tag-text {
		color: #FFFFFF;
		font-size: 12px;
		font-weight: 500;
	}

	.tag-close {
		color: #FFFFFF;
		font-size: 18px;
		font-weight: bold;
		margin-left: 8rpx;
		line-height: 18px;
	}
</style>

<template>
	<view class="page">
		<!-- 这里是状态栏, 每个页面都需要有，目的不让页面覆盖状态栏 -->
		<!-- <view :style="{height: statusBarHeight + 'px'}"></view>
		<view class="header" :style="{marginTop:statusBarHeight+'px'}">
			<image class="header-right-search"
					src="../../static/images/icon-back.png"  
					style="width: 40rpx;height: 40rpx;opacity: 0.8;" @click="back()"/>			
			<view class="header-center">
				<view class="header-item">
					<text class="header-item-title">{{isEditMode ? '编辑视频' : '发布视频'}}</text>
				</view>
			</view>
			<image class="header-right-search" 
					src="../../static/images/icon-search.png"  
					style="width: 50rpx;height: 50rpx;opacity: 0.8;">
		</view> -->
		
		<!-- 进度条 -->
		<view style="marginTop:60rpx;display: flex;flex-direction: column;justify-content: center;"
			v-if="percentCompleted != 100">
			<progress :percent="percentCompleted" stroke-width="3" activeColor="#ef274d" backgroundColor="#F1F1F1"
				:style="{screenWidth: screenWidth + 'px'}" />
			<text style="color: #F1F1F1;font-size: 16px;text-align: center;margin-top: 20px;"
				:style="{screenWidth: screenWidth + 'px'}">视频上传中~ 请耐心等待~~</text>
			<image mode="aspectFit" src="../../static/images/loading-4.gif"
				style="width: 600rpx;height: 600rpx;align-self: center;">
		</view>
		
		
		<!-- 发布主体内容 -->
		<view v-if="percentCompleted == 100">
			<image :src="tempCover" mode="aspectFit"
				style="marginTop: 30px;width: 360rpx;height: 500rpx;border-radius: 10px;margin-left: 30rpx;margin-top: 10px;">
			</image>
			
			<view class="choose-cover" @click="chooseCover">
				<text style="color: #ffffff;font-size: 14px;align-self: center;">选择封面</text>
			</view>
			
			<view class="preplay-wrapper" 
				:class="{'btn-preplay':!preplayTouched, 'btn-preplay-touched': preplayTouched}" @click="preview"
				@touchstart="touchstartPreplay" @touchend="touchendPreplay">
				<image src="../../static/images/btn-play.png" style="width: 22rpx;height: 22rpx;align-self: center;">
				</image>
				<text style="color: #e6e6e6;font-size: 14px;align-self: center;margin-left: 10rpx;">预览视频</text>
			</view>
			
			<!-- :style="{screenWidth: screenWidth - 150 + 'px'}" -->
		<textarea class="vlog-content" placeholder-style="color: #9798a0;" placeholder="添加合适的标题与标签内容，例如：标题 #风景 #美食" :value="title" :model="title" maxlength="60" @input="typingContent" confirm-type="done"></textarea>

		<!-- 标签预览区域 -->
		<view v-if="tags.length > 0" class="tags-preview">
			<text class="tags-label">标签：</text>
			<view class="tags-container">
				<view v-for="(tag, index) in tags" :key="index" class="tag-item" @click="removeTag(index)">
					<text class="tag-text">#{{tag}}</text>
					<text class="tag-close">×</text>
				</view>
			</view>
		</view>
			
			<!-- <view :style="{screenWidth: screenWidth + 'px'}" style="height: 1rpx;background-color: #383a44;margin-top: 20rpx;"></view> -->
			
			<view :class="{'btn-publish':!publichTouched, 'btn-publish-touched': publichTouched}" 
				style="margin-top: 30rpx;height: 90rpx;display: flex;justify-content: center;border-radius: 20px;"
				@touchstart="touchstartPublich" @touchend="touchendPublich" @click="doPublich">
				<text style="color: #e6e6e6;font-size: 18px;align-self: center;font-weight: 500;">{{isEditMode ? '保存修改' : '发布 Vlog'}}</text>
			</view>
		</view>
		
		
	</view>
</template>

<script>
	var system = uni.getSystemInfoSync();
	var app = getApp();
	export default {
		data() {
			return {
				publichTouched: false,
				preplayTouched: false,
				// tempCover: "/static/face/face-arrow-1.png",
				tempFilePath: "",
				videoUrl: "",
				tempCover: "",
				title: "",
				width: 0,
				height: 0,
				
				percentCompleted: 0,
				tags: [], // 标签数组
				
				// 编辑模式相关
				isEditMode: false, // 是否为编辑模式
				editVlogId: "", // 编辑的视频ID
			}
		},
		onLoad(params) {
			var me = this;
			this.statusBarHeight = system.statusBarHeight;
			this.screenWidth = system.screenWidth;

			// 检查是否为编辑模式
			if (params.mode === 'edit' && params.vlogId) {
				me.isEditMode = true;
				me.editVlogId = params.vlogId;
				me.percentCompleted = 100; // 编辑模式下直接显示编辑表单
				
				// 动态设置导航栏标题
				uni.setNavigationBarTitle({
					title: '编辑视频'
				});
				
				// 获取视频详情并填充表单
				me.fetchVlogDetail(params.vlogId);
			} else {
				me.isEditMode = false;
				
				// 动态设置导航栏标题（发布模式）
				uni.setNavigationBarTitle({
					title: '发布视频'
				});
				
				// 发布模式：上传视频
			
			// 上个页面传过来的文件事件对象，其中包含了相册中选择的视频内容
			var fileObjectEvent = JSON.parse(params.fileObjectEvent);
				
				// 处理时间格式
				function formatDate(date) {
				    var year = date.getFullYear();
				    var month = (date.getMonth() + 1).toString().padStart(2, '0');
				    var day = date.getDate().toString().padStart(2, '0');
				    var hours = date.getHours().toString().padStart(2, '0');
				    var minutes = date.getMinutes().toString().padStart(2, '0');
				    var seconds = date.getSeconds().toString().padStart(2, '0');
				    return year + month + day + '_' + hours + minutes + seconds;
				}
				var time = formatDate(new Date());
			var times = new Date().getTime();
				
				// 获取用户名
				var userInfo = getApp().getUserInfoSession();
				var username = '';
				if (userInfo && userInfo.nickname) {
					// 清理用户名中的特殊字符，只保留字母、数字、中文、下划线
					username = userInfo.nickname.replace(/[^a-zA-Z0-9\u4e00-\u9fa5_]/g, '');
				}

				// 文件名 = 用户名 + 时间 + 时间戳 + .mp4
				var cloudPath =(username ? username + '_' : '') +time + '_' +times +'.mp4';

			uniCloud.uploadFile({
				filePath: fileObjectEvent.tempFilePath,
					cloudPath: cloudPath,
				onUploadProgress(progressEvent) {
					// 进度百分比
					var percentCompleted = Math.round((progressEvent.loaded * 100) / progressEvent.total);
					me.percentCompleted = percentCompleted;
				},
				success(f) {
					var videoUrlTemp = f.filePath;
					var videoUrl = f.fileID;

					// 获得视频参数
					me.tempFilePath = videoUrlTemp;
					me.videoUrl = videoUrl;
						me.tempCover = videoUrl + "?x-oss-process=video/snapshot,t_1,f_jpg,ar_auto"; // 截帧
					me.width = fileObjectEvent.width;
					me.height = fileObjectEvent.height;
				}
			});
			}
		},
		methods: {
			// 获取视频详情（编辑模式使用）
			fetchVlogDetail(vlogId) {
				var me = this;
				var userId = getApp().getUserInfoSession().id;
				var serverUrl = app.globalData.serverUrl;
				
				uni.request({
					method: "GET",
					header: {
						headerUserId: userId,
						headerUserToken: app.getUserSessionToken()
					},
					url: serverUrl + "/vlog/detail?userId=" + userId + "&vlogId=" + vlogId,
					success(result) {
						if (result.data.status == 200) {
							var vlog = result.data.data;
							
							// 调试日志：打印获取到的视频数据
							console.log("获取到的视频详情：", vlog);
							console.log("视频标题（content）：", vlog.content);
							console.log("视频标题（title）：", vlog.title);
							
							// 填充表单数据
							// 注意：后端返回的字段是 content，不是 title
							me.videoUrl = vlog.url;
							me.tempCover = vlog.cover;
							me.title = vlog.content || vlog.title || "";
							me.width = vlog.width || 0;
							me.height = vlog.height || 0;
							
							// 调试日志：确认赋值后的值
							console.log("赋值后的 title：", me.title);
							
							// 解析标签
							if (vlog.tag && vlog.tag.trim() !== '') {
								// 标签可能是逗号分隔的字符串
								var tagArray = vlog.tag.split(',').map(function(tag) {
									return tag.trim();
								}).filter(function(tag) {
									return tag && tag.length > 0;
								});
								me.tags = tagArray;
							} else {
								me.tags = [];
							}
							
							// 如果标题中包含标签，需要重新解析标签（因为标签是从标题中解析的）
							if (me.title && me.title.trim() !== '') {
								// 使用 $nextTick 确保 DOM 更新后再解析标签
								me.$nextTick(function() {
									me.parseTags(me.title);
									// 强制更新视图
									me.$forceUpdate();
								});
							} else {
								// 即使标题为空，也强制更新视图以确保 textarea 显示空值
								me.$nextTick(function() {
									me.$forceUpdate();
								});
							}
						} else {
							uni.showToast({
								title: result.data.msg || "获取视频详情失败",
								icon: "none",
								duration: 3000
							});
							// 获取失败，返回上一页
							setTimeout(function() {
								uni.navigateBack();
							}, 1500);
						}
					},
					fail(err) {
						console.error("获取视频详情失败：", err);
						uni.showToast({
							title: "网络错误，请重试",
							icon: "none",
							duration: 3000
						});
						// 获取失败，返回上一页
						setTimeout(function() {
							uni.navigateBack();
						}, 1500);
					}
				});
			},
			
			typingContent(e) {
				var event = e;
				var content = e.detail.value;
				this.title = content;
				
				// 实时解析标签：匹配 #标签 格式（#后面跟非空格字符，直到遇到空格或结尾）
				this.parseTags(content);
			},
			
			// 解析文本中的标签
			parseTags(content) {
				var me = this;
				var tags = [];
				
				if (!content || content.trim() === '') {
					me.tags = [];
					return;
				}
				
				// 匹配 #标签 格式
				// 正则说明：# 后面跟一个或多个非空格字符，直到遇到空格、换行或字符串结尾
				var tagRegex = /#([^\s#]+)/g;
				var match;
				var tagSet = new Set(); // 使用Set去重
				
				while ((match = tagRegex.exec(content)) !== null) {
					var tag = match[1].trim();
					// 过滤空标签和过长的标签（限制20个字符）
					if (tag && tag.length > 0 && tag.length <= 20) {
						tagSet.add(tag);
					}
				}
				
				// 转换为数组
				me.tags = Array.from(tagSet);
			},
			
			// 删除标签
			removeTag(index) {
				var me = this;
				var tagToRemove = me.tags[index];
				
				// 从文本中移除该标签
				if (tagToRemove) {
					// 移除文本中对应的 #标签
					var regex = new RegExp('#\\s*' + tagToRemove.replace(/[.*+?^${}()|[\]\\]/g, '\\$&') + '\\s*', 'g');
					me.title = me.title.replace(regex, '');
					
					// 重新解析标签
					me.parseTags(me.title);
				}
			},
			doPublich() {
				var me = this;
				var userId = getApp().getUserInfoSession().id;
				
				// 将标签数组转换为字符串，用逗号分隔（或根据后端需求调整格式）
				var tagsStr = me.tags.join(',');
				
				// 如果标签为空，设置为空字符串而不是undefined
				if (!tagsStr || tagsStr.trim() === '') {
					tagsStr = '';
				}

				var vlog = {
					"vlogerId": userId,
					"url": me.videoUrl,
					"cover": me.tempCover,
					"title": me.title,
					"width": me.width,
					"height": me.height,
					"tag": tagsStr // 添加标签字段，确保字段名与后端BO对象一致
				};

				// 如果是编辑模式，添加视频ID
				if (me.isEditMode) {
					vlog.id = me.editVlogId;
				}

				// 调试日志：打印发送的数据
				console.log("准备" + (me.isEditMode ? "更新" : "发布") + "视频，数据：", JSON.stringify(vlog));

				// 发布或更新视频
				var serverUrl = app.globalData.serverUrl;
				var requestUrl = me.isEditMode ? serverUrl + "/vlog/update" : serverUrl + "/vlog/publish";
				var requestMethod = me.isEditMode ? "PUT" : "POST";
				
				uni.request({
					method: requestMethod,
					header: {
						"Content-Type": "application/json", // 确保设置Content-Type
						"headerUserId": userId,
						"headerUserToken": app.getUserSessionToken()
					},
					url: requestUrl,
					data: vlog,
					success(result) {
						console.log((me.isEditMode ? "更新" : "发布") + "视频响应：", result);
						
						if (result.data.status == 200) {
							uni.showToast({
								title: me.isEditMode ? "更新成功！" : "发布成功！",
								icon: "none"
							})
							
							// 编辑模式下，返回上一页（视频详情页）
							if (me.isEditMode) {
								uni.navigateBack({
									delta: 1,
									animationType: 'zoom-fade-in',
									animationDuration: 1000
								});
							} else {
								// 发布模式下，返回并切换到个人中心
							uni.navigateBack({
								delta: 1,
								animationType: 'zoom-fade-in',
								animationDuration: 1000
							});
							
							uni.switchTab({
								url: "../me/me"
							})
							}
						} else {
							uni.showToast({
								title: result.data.msg || (me.isEditMode ? "更新失败" : "发布失败"),
								icon: "none",
								duration: 3000
							});
						}
						
					},
					fail(err) {
						console.error((me.isEditMode ? "更新" : "发布") + "视频请求失败：", err);
						uni.showToast({
							title: "网络错误，请重试",
							icon: "none",
							duration: 3000
						});
					}
				});
				
			},
			
			preview() {
				uni.navigateTo({
					url: "/pages/publish/preview?videoUrl=" + this.videoUrl + "&width=" + this.width + "&height=" +
						this.height,
					animationType: 'slide-in-bottom',
					animationDuration: 500
				})
			},
			
			touchstartPreplay() {
				this.preplayTouched = true;
			},
			
			touchendPreplay() {
				this.preplayTouched = false;
			},
			
			touchstartPublich() {
				this.publichTouched = true;
			},
			
			touchendPublich() {
				this.publichTouched = false;
			},
			
			chooseCover() {
				var me = this;
				var userId = getApp().getUserInfoSession().id;
				
				uni.chooseImage({
					count: 1,
					sourceType: ['album'],
					success(e) {
						me.tempCover = e.tempFilePaths[0];
						
						// 上传封面
						var serverUrl = app.globalData.serverUrl;
						uni.uploadFile({
							url: serverUrl + "/file/uploadImage?userId=" + userId,
							name: "file",
							filePath: me.tempCover,
							success(result) {
								var res = JSON.parse(result.data);
								if (res.status == 200) {
									var imageUrl = res.data;
									me.tempCover = imageUrl;
								} else {
									uni.showToast({
										title: result.data.msg,
										icon: "none",
										duration: 3000
									});
								}
							}
						})
					}
				})
			}
			
		}
	}
</script>
